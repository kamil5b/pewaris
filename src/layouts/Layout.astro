---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Pewaris',
  description = 'Kalkulator waris Islam interaktif berdasarkan KHI. Simulasi bagi harta warisan dengan tepat.'
} = Astro.props

const ogImage = new URL('/pewaris/og.png', Astro.site).href
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/pewaris/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="id_ID" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <slot />
  </body>
</html>
